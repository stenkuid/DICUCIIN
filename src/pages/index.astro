---
import Layout from '../layouts/Layout.astro';

const items = [{"name": "Cuci Kering Segar", "price": "Rp 6.000 / kg", "desc": "Pakaian dicuci bersih mendalam dan dikeringkan dengan pewangi harum tahan lama.", "img": "https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?w=500&q=80", "badge": "HEMAT"}, {"name": "Cuci + Setrika Rapi", "price": "Rp 9.000 / kg", "desc": "Pakaian dicuci higienis, dikeringkan, dan disetrika sampai halus licin sempurna.", "img": "https://images.unsplash.com/photo-1545173168-9f1947eebb7f?w=500&q=80", "badge": "POPULAR"}, {"name": "Express Laundry 6 Jam", "price": "Rp 15.000 / kg", "desc": "Layanan kilat 6 jam selesai untuk kebutuhan pakaian bersih yang mendesak.", "img": "https://images.unsplash.com/photo-1582735689369-4fe89db7114c?w=500&q=80", "badge": "EXPRESS"}, {"name": "Dry Clean & Bed Cover", "price": "Rp 35.000 / pcs", "desc": "Perawatan khusus selimut tebal, bed cover, gaun, dan jas kesayangan.", "img": "https://images.unsplash.com/photo-1521656693074-0ef32e80a5d5?w=500&q=80", "badge": "PREMIUM"}];
const features = [{"icon": "\ud83e\uddfc", "title": "Deterjen anti-Bakteri", "desc": "Menghilangkan noda membandel sekaligus membunuh 99.9% kuman dan bakteri."}, {"icon": "\ud83c\udf38", "title": "Pewangi Tahan 7 Hari", "desc": "Formula parfum mikro-kapsul yang menjaga kesegaran pakaian tersimpan lebih lama."}, {"icon": "\ud83d\ude9a", "title": "Antar Jemput Gratis", "desc": "Bebas repot, tim kami siap mengambil & mengantar pakaian langsung ke depan pintu rumah."}];
const stats = [{"num": "4.9 \u2605", "label": "Ulasan Pelanggan"}, {"num": "100%", "label": "Bebas Kuman & Bakteri"}, {"num": "< 6 Jam", "label": "Layanan Express"}];
---

<Layout title="DiCuciin — Jasa Laundry Praktis & Bersih">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-badge">
        <span>🧺 Layanan Laundry Express 6 Jam Selesai</span>
      </div>
      <h1 class="hero-title">
        Cucian Numpuk? DiCuciin Aja.<br />
        <span class="text-gradient-accent">Kualitas Impeccable Terbaik.</span>
      </h1>
      <p class="hero-desc">
        Serahkan pakaian kotormu kepada kami dan gunakan waktumu untuk hal yang lebih penting. Laundry wangi, bersih, bebas kuman, dan disetrika rapi.
      </p>

      <div class="hero-buttons">
        <a href="#katalog" class="btn">
          <span>Jelajahi Katalog</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://wa.me/?text=Halo%20DICUCIIN,%20saya%20mau%20konsultasi%20order" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Pesan via WhatsApp</span>
        </a>
      </div>

      <div class="hero-stats">
        {stats.map((s) => (
          <div class="stat-item">
            <h3>{s.num}</h3>
            <p>{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Keunggulan Section -->
  <section id="keunggulan" class="section container">
    <div class="section-header">
      <p class="section-subtitle">MENGAPA MEMILIH KAMI</p>
      <h2 class="section-title">Keunggulan Utama DICUCIIN</h2>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Katalog Section -->
  <section id="katalog" class="section container">
    <div class="section-header">
      <p class="section-subtitle">PILIHAN TERBAIK</p>
      <h2 class="section-title">Katalog Produk & Layanan Unggulan</h2>
    </div>
    <div class="cards-grid">
      {items.map((item) => (
        <div class="card">
          <div class="card-img-wrap">
            <img src={item.img} alt={item.name} class="card-img" />
            <span class="badge">{item.badge}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">{item.name}</h3>
            <p class="card-desc">{item.desc}</p>
            <div class="card-footer">
              <span class="card-price">{item.price}</span>
              <a href={`https://wa.me/?text=Halo%20DICUCIIN,%20saya%20tertarik%20order%20${encodeURIComponent(item.name)}`} class="btn btn-card" target="_blank" rel="noopener noreferrer">
                <span>Pesan</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Box Section -->
  <section id="lokasi" class="container">
    <div class="cta-box">
      <div class="cta-content">
        <h2 class="cta-title">Siap Menikmati Layanan Terbaik dari DICUCIIN?</h2>
        <p class="cta-desc">Hubungi tim kami via WhatsApp resmi untuk konsultasi gratis, tanya jawab produk, atau pemesanan cepat hari ini.</p>
        <a href="https://wa.me/?text=Halo%20DICUCIIN" class="btn" style="padding: 1rem 2.5rem; font-size: 1.1rem;" target="_blank" rel="noopener noreferrer">
          <span>Hubungi Kami Sekarang</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
