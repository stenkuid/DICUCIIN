---
import Layout from '../layouts/Layout.astro';

const stats = [{'val': '1 Customer 1 Mesin', 'lbl': 'Higienis Terjamin'}, {'val': '6 Jam', 'lbl': 'Paket Express'}, {'val': 'Gratis', 'lbl': 'Antar Jemput Radius 5km'}, {'val': '100%', 'lbl': 'Garansi Bersih & Wangi'}];
const items = [{'name': 'Laundry Kiloan Reguler (2 Hari)', 'desc': 'Cuci, kering, setrika uap, dan wangi parfum premium pilihan.', 'price': 'Rp 7.000 / kg', 'tag': 'Hemat'}, {'name': 'Laundry Kiloan Express (6 Jam)', 'desc': 'Selesai di hari yang sama untuk kebutuhan mendesak Anda.', 'price': 'Rp 14.000 / kg', 'tag': 'Cepat'}, {'name': 'Cuci Sepatu & Sneakers Premium', 'desc': 'Pembersihan mendalam sol, upper, dan insoles tanpa merusak bahan.', 'price': 'Rp 35.000 / pasang', 'tag': 'Specialist'}, {'name': 'Dry Clean Jas & Dress Manten', 'desc': 'Perawatan bahan halus sutra, wool, dan gaun tanpa air basah.', 'price': 'Rp 45.000 / pcs', 'tag': 'Care'}];
const features = [{'icon': '📱', 'title': '1. Pesan via WhatsApp', 'desc': 'Kirimkan alamat dan waktu penjemputan pakaian kotor Anda.'}, {'icon': '🛵', 'title': '2. Kurir Meluncur', 'desc': 'Tim kami menjemput pakaian langsung di depan pintu rumah Anda.'}, {'icon': '✨', 'title': '3. Cuci & Setrika Uap', 'desc': 'Dicuci terpisah tiap pelanggan dan disetrika uap antibakteri.'}];
---

<Layout title="DiCuciin — Jasa Laundry & Care Pakaian">
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        🧺 Layanan Express 6 Jam Selesai
      </div>
      <h1 class="hero-title">DARIPADA RIBET NYUCI, MENDING DICUCIIN</h1>
      <p class="hero-desc">Pakaian wangi, rapi, dan higienis tanpa harus keluar rumah. Kami jemput pakaian kotor Anda dan antar kembali dalam kondisi siap pakai.</p>
      
      <div style="display: flex; gap: 1rem; justify-content: center; align-items: center;">
        <a href="https://wa.me/6281234567890" class="btn-cta">
          Pesan Sekarang via WhatsApp
        </a>
        <a href="#katalog" style="padding: 0.75rem 1.5rem; border-radius: 99px; border: 1px solid var(--card-border); color: var(--text-main); font-weight: 600;">
          Lihat Katalog
        </a>
      </div>

      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-val">{stat.val}</div>
            <div class="stat-lbl">{stat.lbl}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="container">
      <h2 class="section-title">PILAHAN PRODUK & LAYANAN UNGGULAN</h2>
      <div class="item-grid">
        {items.map((item) => (
          <div class="item-card">
            <div>
              <span class="item-tag">{item.tag}</span>
              <h3 class="item-name">{item.name}</h3>
              <p class="item-desc">{item.desc}</p>
            </div>
            <div class="item-footer">
              <span class="item-price">{item.price}</span>
              <a href="https://wa.me/6281234567890" style="color: var(--accent); font-weight: 700; font-size: 0.9rem;">Pesan &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="keunggulan" class="features-section">
    <div class="container">
      <h2 class="section-title">4 LANGKAH PRAKTIS DICUCIIN</h2>
      <div class="features-grid">
        {features.map((feat) => (
          <div class="feature-card">
            <div class="feature-icon">{feat.icon}</div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-desc">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
