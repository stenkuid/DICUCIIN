---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Serahkan pakaian kotormu kepada kami dan gunakan waktumu untuk hal yang lebih penting. Laundry wangi, bersih, dan rapi." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <div class="container nav-wrap">
        <a href="/" class="logo">DICUCIIN</a>
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="#menu">Katalog</a>
          <a href="#lokasi">Lokasi</a>
          <a href="/admin" style="font-weight:700; color:var(--accent);">Admin Login</a>
          <a href="https://wa.me/?text=Halo%20DICUCIIN" class="btn" target="_blank">Order via WA</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2026 DICUCIIN. All rights reserved. | <a href="/admin">Dashboard Admin</a> | Hosted on Cloudflare Pages (https://dicuciin.pages.dev)</p>
      </div>
    </footer>
  </body>
</html>
